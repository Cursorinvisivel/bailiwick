{
  "drill": "purge",
  "command": "/drill-purge acme-drill",
  "tokens": {"id": "acme-drill", "org_token": "acdr", "org_name": "Acme Drill Industries", "abbrev": "ADI"},
  "patterns": [
    {"name": "id", "regex": "acme[-_ ]?drill", "flags": "i"},
    {"name": "org_token", "regex": "(?<![a-z0-9])acdr(?![a-z0-9])", "flags": "i"},
    {"name": "org_name", "regex": "acme\\s+drill\\s+industries", "flags": "i"},
    {"name": "abbrev", "regex": "(?<![A-Za-z0-9])ADI(?![A-Za-z0-9])", "flags": ""}
  ],
  "b64_literals": ["acme-drill", "Acme Drill Industries"],
  "sweep_roots": ["framework", "project", "home-bailiwick"],
  "sweep_exclude": ["project/.claude"],
  "erasure_tier": "de-identified (no --history): history residuals are expected",
  "traces": [
    {"id": "T01", "surface": "clients/<id>/ subtree", "location": "framework/knowledge/clients/acme-drill/", "form": "dirname", "expected": "removed",
     "probe": {"type": "path", "path": "framework/knowledge/clients/acme-drill"}},
    {"id": "T02", "surface": "clients/<id>/ file (client-specific: DELETE)", "location": "framework/knowledge/clients/acme-drill/project-map.md", "form": "plain", "expected": "removed",
     "probe": {"type": "path", "path": "framework/knowledge/clients/acme-drill/project-map.md"}},
    {"id": "T03", "surface": "topic file name (reusable rule: ABSTRACT + rename)", "location": "framework/knowledge/topics/acme-drill-vpc-sc-rollout.md", "form": "filename", "expected": "abstracted",
     "probe": {"type": "path", "path": "framework/knowledge/topics/acme-drill-vpc-sc-rollout.md"}},
    {"id": "T04", "surface": "frontmatter scope", "location": "framework/knowledge/** scope: client:acme-drill", "form": "frontmatter", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge", "regex": "scope:\\s*client:acme-drill", "flags": "i"}},
    {"id": "T05", "surface": "inline mention (topic body)", "location": "framework/knowledge/topics/**", "form": "org-name", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/topics", "pattern": "org_name"}},
    {"id": "T06", "surface": "inline mention (topic body)", "location": "framework/knowledge/** acme_drill", "form": "slug-underscore", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge", "regex": "acme_drill", "flags": "i"}},
    {"id": "T07", "surface": "INDEX.md rows (topics + clients)", "location": "framework/knowledge/INDEX.md", "form": "plain", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/INDEX.md", "pattern": "id"}},
    {"id": "T08", "surface": "## Related link target", "location": "framework/knowledge/patterns/gcp-iam-conventions.md", "form": "link-target", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/patterns/gcp-iam-conventions.md", "pattern": "id"}},
    {"id": "T09", "surface": "inline mention (generic pattern)", "location": "framework/knowledge/patterns/caf-naming-taxonomy.md", "form": "uppercase", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/patterns/caf-naming-taxonomy.md", "regex": "ACME-DRILL", "flags": ""}},
    {"id": "T10", "surface": "inline mention (generic pattern)", "location": "framework/knowledge/patterns/caf-naming-taxonomy.md", "form": "org-token", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/patterns/caf-naming-taxonomy.md", "pattern": "org_token"}},
    {"id": "T11", "surface": "inline mention (generic pattern)", "location": "framework/knowledge/patterns/gcp-labels-required.md", "form": "abbreviation", "expected": "abstracted",
     "probe": {"type": "regex", "path": "framework/knowledge/patterns/gcp-labels-required.md", "pattern": "abbrev"}},
    {"id": "T12", "surface": "org-shorthands registry row", "location": "framework/knowledge/context/org-shorthands.md", "form": "registry", "expected": "removed",
     "probe": {"type": "regex", "path": "framework/knowledge/context/org-shorthands.md", "pattern": "id"}},
    {"id": "T13", "surface": ".telemetry.json entry key", "location": "framework/knowledge/.telemetry.json entries{}", "form": "telemetry-key", "expected": "removed", "satellite_expected": "pending-central",
     "probe": {"type": "json_keys", "path": "framework/knowledge/.telemetry.json", "pattern": "id"}},
    {"id": "T14", "surface": ".telemetry.json distinct_projects_used[]", "location": "framework/knowledge/.telemetry.json", "form": "telemetry-value", "expected": "removed", "satellite_expected": "pending-central",
     "probe": {"type": "json_values", "path": "framework/knowledge/.telemetry.json", "pattern": "id"}},
    {"id": "T15", "surface": "definitions/clients/<id>/ subtree", "location": "framework/definitions/clients/acme-drill/", "form": "dirname", "expected": "removed",
     "probe": {"type": "path", "path": "framework/definitions/clients/acme-drill"}},
    {"id": "T16", "surface": "definitions binary", "location": "framework/definitions/clients/acme-drill/logo.png", "form": "binary", "expected": "removed",
     "probe": {"type": "path", "path": "framework/definitions/clients/acme-drill/logo.png"}},
    {"id": "T17", "surface": "git commit message", "location": "framework git log --all", "form": "commit-msg", "expected": "residual-expected",
     "probe": {"type": "git_messages", "repo": "framework", "pattern": "id"}},
    {"id": "T18", "surface": "git history diffs", "location": "framework git log --all -S acme-drill", "form": "history", "expected": "residual-expected",
     "probe": {"type": "git_diffs", "repo": "framework", "literal": "acme-drill"}},
    {"id": "T19", "surface": "local seeded raw capture (content match; no origin stamp)", "location": "project/.bailiwick-outputs/raw/drill0001-acme.jsonl", "form": "plain", "expected": "removed",
     "note": "gap probe: unstamped capture (no origin_remote; only a token-content pass finds it)",
     "probe": {"type": "path", "path": "project/.bailiwick-outputs/raw/drill0001-acme.jsonl"}},
    {"id": "T20", "surface": "central shadow capture, origin_remote = client", "location": "home-bailiwick/captures/landing-zone-1a2b3c4d/raw/drill0002-acme.{jsonl,md}", "form": "origin-stamp", "expected": "removed",
     "probe": {"type": "path", "path": "home-bailiwick/captures/landing-zone-1a2b3c4d/raw/drill0002-acme.md"}},
    {"id": "T21", "surface": "base64-encoded copy inside a capture", "location": "home-bailiwick/captures/landing-zone-1a2b3c4d/raw/drill0002-acme.jsonl", "form": "base64", "expected": "removed",
     "probe": {"type": "literal", "path": "", "text": "Y2x1c3RlcjogYWNtZS1kcmlsbC1na2UtcHJkCnByb2plY3Q6IGFjZHItcHJqLWRhdGEtcHJkCg=="}},
    {"id": "T22", "surface": ".bailiwick-inbox (decrypted pool)", "location": "framework/.bailiwick-inbox/raw/drillbox/landing-zone-1a2b3c4d/drill0004-acme.jsonl", "form": "plain", "expected": "removed",
     "probe": {"type": "path", "path": "framework/.bailiwick-inbox/raw/drillbox/landing-zone-1a2b3c4d/drill0004-acme.jsonl"}},
    {"id": "T23", "surface": "guardrail audit log", "location": "home-bailiwick/guardrail-audit.log", "form": "path+command", "expected": "removed",
     "probe": {"type": "regex", "path": "home-bailiwick/guardrail-audit.log", "pattern": "any"}},
    {"id": "T24", "surface": "health shard (local)", "location": "home-bailiwick/health/drillbox.jsonl", "form": "plain", "expected": "removed",
     "probe": {"type": "regex", "path": "home-bailiwick/health/drillbox.jsonl", "pattern": "any"}},
    {"id": "T25", "surface": "health shard (remote copy)", "location": "home-bailiwick/health/remote/otherbox.jsonl", "form": "org-name", "expected": "removed",
     "probe": {"type": "regex", "path": "home-bailiwick/health/remote/otherbox.jsonl", "pattern": "any"}},
    {"id": "T26", "surface": "any file or dir NAME", "location": "framework (no .git), project, home-bailiwick", "form": "filename", "expected": "removed",
     "probe": {"type": "names", "paths": ["framework", "project", "home-bailiwick"], "pattern": "any"}},
    {"id": "T27", "surface": "Claude Code file-history/<session>/ (drill config dir)", "location": "$CLAUDE_CONFIG_DIR/file-history/<planted session>/", "form": "pre-edit copy", "expected": "pending-user-action",
     "note": "host state a purge can only LIST for the user (Step 5b); the protocol says do not run those commands",
     "probe": {"type": "claude_file_history"}},
    {"id": "T28", "surface": "Claude Code history.jsonl (drill config dir)", "location": "$CLAUDE_CONFIG_DIR/history.jsonl lines for the sandbox project", "form": "typed prompt", "expected": "pending-user-action",
     "note": "host state a purge can only LIST for the user (Step 5b); counts the planted line plus the drill session's own",
     "probe": {"type": "claude_history", "pattern": "any"}},
    {"id": "T29", "surface": "central shadow /learn capture (manual channel, outside raw/)", "location": "home-bailiwick/captures/landing-zone-1a2b3c4d/learn-20261018-101500.md", "form": "origin-stamp", "expected": "removed",
     "note": "deletable only because purge_delete.sh allows $H/captures/<key>/*.md (curate's manual gather dir)",
     "probe": {"type": "path", "path": "home-bailiwick/captures/landing-zone-1a2b3c4d/learn-20261018-101500.md"}}
  ],
  "user_action_markers": [["file-history"], ["history.jsonl"]],
  "rule": {
    "description": "Reusable VPC-SC rule (dry-run >= 14 days, review violations, then enforce) survives in a de-identified knowledge file",
    "where": "framework/knowledge",
    "keywords": [["dry-run", "dry run"], ["14 days", "two weeks", "14-day", "2 weeks", "fourteen days"], ["perimeter"], ["enforc"]]
  },
  "client_file": {
    "path": "framework/knowledge/clients/acme-drill/project-map.md",
    "markers": ["918273645501", "01DR1L-L0ACME-000000"]
  },
  "keep": [
    {"id": "K1", "what": "capture from an unrelated origin", "path": "home-bailiwick/captures/other-repo-9f8e7d6c/raw/drill0003-other.jsonl"},
    {"id": "K2", "what": "capture sharing the repo BASENAME but another origin (globex)", "path": "home-bailiwick/captures/landing-zone-5e6f7a8b/raw/drill0005-globex.jsonl"},
    {"id": "K3", "what": "unrelated audit-log line", "path": "home-bailiwick/guardrail-audit.log", "contains": "/home/op/code/other-repo"},
    {"id": "K4", "what": "unrelated health line", "path": "home-bailiwick/health/drillbox.jsonl", "contains": "index injected"},
    {"id": "K5", "what": "other registry rows", "path": "framework/knowledge/context/org-shorthands.md", "contains": "| `wombat` |"},
    {"id": "K6", "what": "default registry row", "path": "framework/knowledge/context/org-shorthands.md", "contains": "| `acme` |"},
    {"id": "K7", "what": "generic naming pattern intact", "path": "framework/knowledge/patterns/caf-naming-taxonomy.md", "contains": "# Pattern: Resource Naming Taxonomy (Azure CAF-based)"},
    {"id": "K8", "what": "generic labels pattern intact", "path": "framework/knowledge/patterns/gcp-labels-required.md", "contains": "## Terraform implementation"},
    {"id": "K9", "what": "generic IAM pattern intact", "path": "framework/knowledge/patterns/gcp-iam-conventions.md", "contains": "## Auditing"},
    {"id": "K10", "what": "unrelated telemetry row", "path": "framework/knowledge/.telemetry.json", "contains": "\"agent-cli-hook-contracts\""}
  ]
}
